-- منطق تشغيل وإيقاف الـ ESP عبر الزر
EspToggleBtn.MouseButton1Click:Connect(function()
    getgenv().ESP_Enabled = not getgenv().ESP_Enabled
    if getgenv().ESP_Enabled then
        EspToggleBtn.Text = "ESP: ON"
        EspToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        EspToggleBtn.Text = "ESP: OFF"
        EspToggleBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
    end
end)

-- سحب زر الـ ESP
local dragging, dragStart, startPos
EspToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = EspToggleBtn.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging then
        local delta = input.Position - dragStart
        EspToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

